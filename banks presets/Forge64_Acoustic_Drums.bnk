506756757,0.487012987,1,0.7}&#10;&#10;-- Standalone FORGE64 Lua 5.4 instrument. No samples / external dependencies.&#10;-- Persistent state and fixed-size scratch arrays are allocated only here.&#10;-- level/pan are applied here; disable their application here if your host applies&#10;-- those controls again after the script (see README).&#10;local CAP = 1024&#10;local acc, side, force = {}, {}, {}&#10;for i = 0, CAP-1 do acc[i]=0.0; side[i]=0.0; force[i]=0.0 end&#10;local R,Q,W,C,S,G,OG,SG = {},{},{},{},{},{},{},{}&#10;local forceFast,forceSlow = 0.0,0.0&#10;local hitVelocity,detune,hitPosition = 0.0,1.0,0.25&#10;local lowNoise,highNoise = 0.0,0.0&#10;local dcInL,dcInR,dcL,dcR = 0.0,0.0,0.0,0.0&#10;local TWO_PI = 6.283185307179586&#10;local T60_LOG = 6.907755278982137&#10;-- Independent excitation/wash PRNG streams avoid block-size-dependent noise.&#10;local seedA,seedB=1357911,2468021&#10;local function noiseA()&#10;  seedA=(seedA*48271)%2147483647&#10;  return seedA*(2.0/2147483647.0)-1.0&#10;end&#10;local function noiseB()&#10;  seedB=(seedB*48271)%2147483647&#10;  return seedB*(2.0/2147483647.0)-1.0&#10;end&#10;for m=1,NMODES do&#10;  R[m]=0.0; Q[m]=0.0; W[m]=0.0&#10;  C[m]=0.0; S[m]=0.0; G[m]=0.0; OG[m]=0.0; SG[m]=0.0&#10;end&#10;&#10;local wireDelay = {}&#10;local wirePos,wireLP = {},{}&#10;local WIRE_CAP = 1024&#10;for k=1,4 do&#10;  wireDelay[k]={}; wirePos[k]=0; wireLP[k]=0.0&#10;  for j=0,WIRE_CAP-1 do wireDelay[k][j]=0.0 end&#10;end&#10;local wireTimes = {0.00113,0.00161,0.00217,0.00283}&#10;local wireFollower = 0.0&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local hardness=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local position=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local feature=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local damping=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local human=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  local pan=clamp(param(&quot;pan&quot;),-1.0,1.0)&#10;  local left=cos((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  local right=sin((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  if trig then&#10;    hitVelocity=clamp(vel,0.01,1.0)^1.25&#10;    detune=2.0^((rnd()*2.0-1.0)*human*0.09/12.0)&#10;    hitPosition=clamp(0.03+position*0.82+(rnd()*2.0-1.0)*human*0.025,0.0,0.9)&#10;    local impulse=hitVelocity*(1.0+(rnd()*2.0-1.0)*human*0.035)&#10;    -- Identical additions cancel at t=0: no direct waveform reset on retrigger.&#10;    forceFast=forceFast+impulse; forceSlow=forceSlow+impulse&#10;    local ix=hitPosition*16.0&#10;    local j=floor(ix); local a=ix-j&#10;    for m=1,NMODES do&#10;      local offset=(m-1)*17+j+1&#10;      W[m]=shape[offset]*(1.0-a)+shape[offset+1]*a&#10;    end&#10;  end&#10;  local pitch=2.0^(tune/12.0)*detune&#10;  local tau=CONTACT*(1.65-0.95*hardness)*(1.25-0.35*hitVelocity)&#10;  local fast=exp(-dt/tau); local slow=exp(-dt/(2.0*tau))&#10;  local lp=1.0-exp(-TWO_PI*min(sr*0.36,1600.0+hardness*9000.0)*dt)&#10;  local hp=1.0-exp(-TWO_PI*min(sr*0.2,700.0)*dt)&#10;  local wirePole=1.0-exp(-dt/0.004)&#10;  local followerFall=exp(-dt/max(0.005,decay*(0.06+feature*0.14)))&#10;  local dcPole=exp(-TWO_PI*8.0*dt)&#10;  local dtForce=dt/tau&#10;  local gain=OUTPUT*(1.0+drive*3.0)&#10;  for m=1,NMODES do&#10;    local f=BASE*ratios[m]*pitch&#10;    local audible=clamp((sr*0.44-f)/(sr*0.08),0.0,1.0)&#10;    local w=TWO_PI*min(f,sr*0.44)*dt&#10;    local time=decay*(1.0-0.83*damping)*life[m]&#10;    local d=exp(-T60_LOG*dt/max(0.002,time))&#10;    C[m]=cos(w)*d; S[m]=sin(w)*d&#10;    local bright=1.0/(1.0+(ratios[m]*0.12/(0.3+hardness*0.9+hitVelocity*0.3))^2)&#10;    local mix=1.0&#10;    if KIND==&quot;snare&quot; or KIND==&quot;rimshot&quot; then&#10;      if m&gt;20 then mix=0.6 end&#10;    elseif KIND==&quot;kick&quot; then&#10;      if m==31 then mix=1.0-feature*0.8 end&#10;      if m==32 then mix=0.2+feature*0.6 end&#10;    elseif KIND==&quot;tom&quot; then&#10;      if m&gt;20 and m&lt;31 then mix=0.12+feature*0.8 end&#10;    elseif KIND==&quot;stick&quot; then&#10;      mix=(m&lt;21) and 0.13 or (0.4+feature*0.9)&#10;    end&#10;    G[m]=W[m]*amplitude[m]*bright*mix*audible&#10;    OG[m]=pickup[m]*audible&#10;  end&#10;&#10;  -- Chunking also handles host blocks larger than the fixed 1024-sample scratch.&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    local forceActive=abs(forceSlow)&gt;1e-7 or abs(forceFast)&gt;1e-7&#10;    for i=0,count-1 do&#10;      acc[i]=0.0&#10;      local ff=forceFast; local fs=forceSlow&#10;      forceFast=ff*fast; forceSlow=fs*slow&#10;      local noise=noiseA()&#10;      lowNoise=lowNoise+lp*(noise-lowNoise)&#10;      force[i]=(fs-ff)*dtForce*(1.0+lowNoise*(0.12+hardness*0.35))&#10;    end&#10;    for m=1,NMODES do&#10;      local r,q=R[m],Q[m]&#10;      local c,s,g,og=C[m],S[m],G[m],OG[m]&#10;      if abs(r)+abs(q)&gt;1e-7 or forceActive then&#10;        for i=0,count-1 do&#10;          q=q+force[i]*g&#10;          local nr=r*c-q*s&#10;          q=r*s+q*c; r=nr&#10;          acc[i]=acc[i]+r*og&#10;        end&#10;      end&#10;      if abs(r)+abs(q)&lt;1e-7 then r=0.0; q=0.0 end&#10;      R[m]=r; Q[m]=q&#10;    end&#10;    for i=0,count-1 do&#10;      local body=acc[i]&#10;      local wire=0.0&#10;      if KIND==&quot;snare&quot; or KIND==&quot;rimshot&quot; then&#10;        -- Stochastic collisions driven by membrane motion; four short dispersive&#10;        -- waveguide loops supply the wire texture. This is an approximation,&#10;        -- not a geometric simulation of individual coils.&#10;        wireFollower=max(abs(body),wireFollower*followerFall)&#10;        local collision=max(0.0,wireFollower-0.0015)*noiseB()&#10;        highNoise=highNoise+hp*(collision-highNoise)&#10;        local source=collision-highNoise&#10;        for k=1,4 do&#10;          local length=min(WIRE_CAP-1,max(2,floor(wireTimes[k]*sr*(1.3-feature*0.45))))&#10;          local at=wirePos[k]&#10;          if at&gt;=length then at=0 end&#10;          local delayed=wireDelay[k][at]&#10;          local filtered=wireLP[k]*0.32+delayed*0.68&#10;          wireLP[k]=filtered&#10;          local value=source*0.3+filtered*(0.42+feature*0.32)&#10;          value=value/(1.0+abs(value)*0.3)&#10;          if abs(value)&lt;1e-7 then value=0.0 end&#10;          wireDelay[k][at]=value; wirePos[k]=(at+1)%length&#10;          wire=wire+delayed&#10;        end&#10;        wire=wire*feature*1.35&#10;      end&#10;      local sig=body+wire&#10;      local xL=sig*left; local xR=sig*right&#10;      local yL=xL-dcInL+dcPole*dcL; local yR=xR-dcInR+dcPole*dcR&#10;      dcInL=xL; dcInR=xR; dcL=yL; dcR=yR&#10;      if abs(dcL)&lt;1e-7 then dcL=0.0 end&#10;      if abs(dcR)&lt;1e-7 then dcR=0.0 end&#10;      outL(start+i,tanh(yL*gain)*level)&#10;      outR(start+i,tanh(yR*gain)*level)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(forceFast)&lt;1e-7 then forceFast=0.0 end&#10;  if abs(forceSlow)&lt;1e-7 then forceSlow=0.0 end&#10;  if abs(wireFollower)&lt;1e-7 then wireFollower=0.0 end&#10;  if abs(lowNoise)&lt;1e-7 then lowNoise=0.0 end&#10;  if abs(highNoise)&lt;1e-7 then highNoise=0.0 end&#10;  for k=1,4 do if abs(wireLP[k])&lt;1e-7 then wireLP[k]=0.0 end end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="HARDNESS" p2Label="HIT POS" p3Label="RESO HEAD" p4Label="DAMPING" p5Label="HUMAN" />
  <pad name="Closed hi-hat" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: TIP&#10;-- @p3: WASH&#10;-- @p4: CHOKE&#10;-- @p5: WIDTH&#10;&#10;-- Closed hi-hat. Recommended decay=0.16s; p1=0.6, p2=0.08, p3=0.28, p4=0.7, p5=0.08.&#10;local NMODES=32&#10;local CONTACT=0.0004&#10;local BLOOM=0.001&#10;local OUTPUT=5.81904750343&#10;local freq={720,1060.56,1505.52,2008.08,2601.36,837.7056,1128.25848,1426.21024,1851.46666,2189.73423,2686.77152,3037.06093,3593.49598,3943.85173,4554.23507,4897.59216,5558.97361,5890.49729,6601.1107,6917.20111,7675.9304,7973.7555,8779.87655,9057.12053,9910.1614,10164.8756,11064.5345,11295.0429,12241.137,12445.9726,13438.4049,13616.2656}&#10;local amplitude={0.34,0.25,0.19,0.14,0.12,0.13,0.122021661,0.114965986,0.108681672,0.10304878,0.0979710145,0.0933701657,0.089182058,0.0853535354,0.0818401937,0.0786046512,0.0756152125,0.0728448276,0.0702702703,0.0678714859,0.065631068,0.0635338346,0.0615664845,0.0597173145,0.0579759863,0.0563333333,0.0547811994,0.0533123028,0.0519201229,0.0505988024,0.0493430657,0.0481481481}&#10;local life={1,0.9,0.85,0.75,0.67,0.48,0.445714286,0.416,0.39,0.367058824,0.346666667,0.328421053,0.312,0.297142857,0.283636364,0.271304348,0.26,0.2496,0.24,0.231111111,0.222857143,0.215172414,0.208,0.201290323,0.195,0.189090909,0.183529412,0.178285714,0.173333333,0.168648649,0.164210526,0.16}&#10;local stereo={0.675463181,-0.996164609,0.793667864,-0.174326781,-0.536572918,0.965657777,-0.887567034,0.343314929,0.381250492,-0.905578362,0.954285094,-0.501789301,-0.21425254,0.817766255,-0.991778853,0.644896733,0.0406932573,-0.704910637,0.998900091,-0.768254661,0.134112228,0.570467634,-0.975430724,0.868085337,-0.304810621,-0.418554465,0.922089485,-0.941331518,0.466174406,0.253823363,-0.840509911,0.98575009}&#10;&#10;-- Standalone FORGE64 Lua 5.4 instrument. No samples / external dependencies.&#10;-- Persistent state and fixed-size scratch arrays are allocated only here.&#10;-- level/pan are applied here; disable their application here if your host applies&#10;-- those controls again after the script (see README).&#10;local CAP = 1024&#10;local acc, side, force = {}, {}, {}&#10;for i = 0, CAP-1 do acc[i]=0.0; side[i]=0.0; force[i]=0.0 end&#10;local R,Q,W,C,S,G,OG,SG = {},{},{},{},{},{},{},{}&#10;local forceFast,forceSlow = 0.0,0.0&#10;local hitVelocity,detune,hitPosition = 0.0,1.0,0.25&#10;local lowNoise,highNoise = 0.0,0.0&#10;local dcInL,dcInR,dcL,dcR = 0.0,0.0,0.0,0.0&#10;local TWO_PI = 6.283185307179586&#10;local T60_LOG = 6.907755278982137&#10;-- Independent excitation/wash PRNG streams avoid block-size-dependent noise.&#10;local seedA,seedB=1357911,2468021&#10;local function noiseA()&#10;  seedA=(seedA*48271)%2147483647&#10;  return seedA*(2.0/2147483647.0)-1.0&#10;end&#10;local function noiseB()&#10;  seedB=(seedB*48271)%2147483647&#10;  return seedB*(2.0/2147483647.0)-1.0&#10;end&#10;for m=1,NMODES do&#10;  R[m]=0.0; Q[m]=0.0; W[m]=0.0&#10;  C[m]=0.0; S[m]=0.0; G[m]=0.0; OG[m]=0.0; SG[m]=0.0&#10;end&#10;&#10;local washEnv, washAttack, energy = 0.0,0.0,0.0&#10;local washLP, washHP = 0.0,0.0&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local bright=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local bell=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local wash=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local choke=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local width=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  local pan=clamp(param(&quot;pan&quot;),-1.0,1.0)&#10;  local left=cos((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  local right=sin((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  if trig then&#10;    hitVelocity=clamp(vel,0.01,1.0)^1.2&#10;    detune=2.0^((rnd()*2.0-1.0)*0.045/12.0)&#10;    local impulse=hitVelocity*(0.97+rnd()*0.06)&#10;    forceFast=forceFast+impulse; forceSlow=forceSlow+impulse&#10;    washEnv=washEnv+impulse; washAttack=washAttack+impulse&#10;    for m=1,NMODES do W[m]=0.94+rnd()*0.12 end&#10;  end&#10;  local pitch=2.0^(tune/12.0)*detune&#10;  local tau=CONTACT*(1.6-bright*0.9)*(1.2-hitVelocity*0.35)&#10;  local fast=exp(-dt/tau); local slow=exp(-dt/(2.0*tau))&#10;  local lp=1.0-exp(-TWO_PI*min(sr*0.4,3500.0+bright*11000.0)*dt)&#10;  local hp=1.0-exp(-TWO_PI*min(sr*0.23,1300.0+bright*1000.0)*dt)&#10;  local effDecay=decay*(1.0-0.985*choke)&#10;  local washFall=exp(-T60_LOG*dt/max(0.003,effDecay*0.65))&#10;  local bloom=exp(-dt/BLOOM)&#10;  local follow=exp(-dt/0.018)&#10;  local dcPole=exp(-TWO_PI*15.0*dt)&#10;  local gain=OUTPUT*(1.0+drive*3.0)&#10;  for m=1,NMODES do&#10;    local f=freq[m]*pitch&#10;    local audible=clamp((sr*0.44-f)/(sr*0.08),0.0,1.0)&#10;    local w=TWO_PI*min(f,sr*0.44)*dt&#10;    local time=max(0.002,effDecay*life[m])&#10;    local d=exp(-T60_LOG*dt/time)&#10;    C[m]=cos(w)*d; S[m]=sin(w)*d&#10;    local tilt=1.0/(1.0+(f/(2000.0+bright*14000.0+hitVelocity*4000.0))^2)&#10;    local zone=(m&lt;=5) and (0.15+bell*1.65) or (1.15-bell*0.75)&#10;    G[m]=amplitude[m]*W[m]*zone*tilt*audible&#10;    OG[m]=audible&#10;    SG[m]=stereo[m]*width*0.35&#10;  end&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    local forceActive=abs(forceSlow)&gt;1e-7 or abs(forceFast)&gt;1e-7&#10;    for i=0,count-1 do&#10;      acc[i]=0.0; side[i]=0.0&#10;      local ff,fs=forceFast,forceSlow&#10;      forceFast=ff*fast; forceSlow=fs*slow&#10;      local noise=noiseA()&#10;      lowNoise=lowNoise+lp*(noise-lowNoise)&#10;      force[i]=(fs-ff)*(dt/tau)*(1.0+lowNoise*0.7)&#10;    end&#10;    for m=1,NMODES do&#10;      local r,q=R[m],Q[m]&#10;      local c,s,g,og,sg=C[m],S[m],G[m],OG[m],SG[m]&#10;      if abs(r)+abs(q)&gt;1e-7 or forceActive then&#10;        for i=0,count-1 do&#10;          q=q+force[i]*g&#10;          local nr=r*c-q*s&#10;          q=r*s+q*c; r=nr&#10;          local x=r*og&#10;          acc[i]=acc[i]+x; side[i]=side[i]+x*sg&#10;        end&#10;      end&#10;      if abs(r)+abs(q)&lt;1e-7 then r=0.0; q=0.0 end&#10;      R[m]=r; Q[m]=q&#10;    end&#10;    for i=0,count-1 do&#10;      local envelope=max(0.0,washEnv-washAttack)&#10;      washEnv=washEnv*washFall; washAttack=washAttack*bloom&#10;      energy=max(abs(acc[i]),energy*follow)&#10;      local noise=noiseB()&#10;      washLP=washLP+lp*(noise-washLP)&#10;      washHP=washHP+hp*(washLP-washHP)&#10;      -- Stochastic unresolved modes; stronger strikes produce a blooming wash.&#10;      -- Energy following is a perceptual approximation of nonlinear behavior.&#10;      local haze=(washLP-washHP)*wash*(envelope*0.20+energy*0.32)&#10;      local mid=acc[i]+haze&#10;      local xL=(mid+side[i])*left; local xR=(mid-side[i])*right&#10;      local yL=xL-dcInL+dcPole*dcL; local yR=xR-dcInR+dcPole*dcR&#10;      dcInL=xL; dcInR=xR; dcL=yL; dcR=yR&#10;      if abs(dcL)&lt;1e-7 then dcL=0.0 end&#10;      if abs(dcR)&lt;1e-7 then dcR=0.0 end&#10;      outL(start+i,tanh(yL*gain)*level)&#10;      outR(start+i,tanh(yR*gain)*level)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(forceFast)&lt;1e-7 then forceFast=0.0 end&#10;  if abs(forceSlow)&lt;1e-7 then forceSlow=0.0 end&#10;  if abs(washEnv)&lt;1e-7 then washEnv=0.0 end&#10;  if abs(washAttack)&lt;1e-7 then washAttack=0.0 end&#10;  if abs(energy)&lt;1e-7 then energy=0.0 end&#10;  if abs(lowNoise)&lt;1e-7 then lowNoise=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="TIP" p3Label="WASH" p4Label="CHOKE" p5Label="WIDTH" />
  <pad name="Pedal hi-hat" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: TIP&#10;-- @p3: WASH&#10;-- @p4: CHOKE&#10;-- @p5: WIDTH&#10;&#10;-- Pedal hi-hat. Recommended decay=0.22s; p1=0.6, p2=0.04, p3=0.18, p4=0.7, p5=0.12.&#10;local NMODES=32&#10;local CONTACT=0.0012&#10;local BLOOM=0.001&#10;local OUTPUT=11.1641338797&#10;local freq={670,986.91,1400.97,1868.63,2420.71,779.5316,1049.9072,1327.16787,1722.89259,2037.66935,2500.19017,2826.15392,3343.94765,3669.97314,4237.96875,4557.48159,5172.93377,5481.43498,6142.70023,6436.83992,7142.87968,7420.02248,8170.1629,8428.15383,9221.95575,9458.98149,10296.1641,10510.6649,11391.0581,11581.669,12505.1823,12670.6916}&#10;local amplitude={0.34,0.25,0.19,0.14,0.12,0.13,0.122021661,0.114965986,0.108681672,0.10304878,0.0979710145,0.0933701657,0.089182058,0.0853535354,0.0818401937,0.0786046512,0.0756152125,0.0728448276,0.0702702703,0.0678714859,0.065631068,0.0635338346,0.0615664845,0.0597173145,0.0579759863,0.0563333333,0.0547811994,0.0533123028,0.0519201229,0.0505988024,0.0493430657,0.0481481481}&#10;local life={1,0.9,0.85,0.75,0.67,0.48,0.445714286,0.416,0.39,0.367058824,0.346666667,0.328421053,0.312,0.297142857,0.283636364,0.271304348,0.26,0.2496,0.24,0.231111111,0.222857143,0.215172414,0.208,0.201290323,0.195,0.189090909,0.183529412,0.178285714,0.173333333,0.168648649,0.164210526,0.16}&#10;local stereo={0.675463181,-0.996164609,0.793667864,-0.174326781,-0.536572918,0.965657777,-0.887567034,0.343314929,0.381250492,-0.905578362,0.954285094,-0.501789301,-0.21425254,0.817766255,-0.991778853,0.644896733,0.0406932573,-0.704910637,0.998900091,-0.768254661,0.134112228,0.570467634,-0.975430724,0.868085337,-0.304810621,-0.418554465,0.922089485,-0.941331518,0.466174406,0.253823363,-0.840509911,0.98575009}&#10;&#10;-- Standalone FORGE64 Lua 5.4 instrument. No samples / external dependencies.&#10;-- Persistent state and fixed-size scratch arrays are allocated only here.&#10;-- level/pan are applied here; disable their application here if your host applies&#10;-- those controls again after the script (see README).&#10;local CAP = 1024&#10;local acc, side, force = {}, {}, {}&#10;for i = 0, CAP-1 do acc[i]=0.0; side[i]=0.0; force[i]=0.0 end&#10;local R,Q,W,C,S,G,OG,SG = {},{},{},{},{},{},{},{}&#10;local forceFast,forceSlow = 0.0,0.0&#10;local hitVelocity,detune,hitPosition = 0.0,1.0,0.25&#10;local lowNoise,highNoise = 0.0,0.0&#10;local dcInL,dcInR,dcL,dcR = 0.0,0.0,0.0,0.0&#10;local TWO_PI = 6.283185307179586&#10;local T60_LOG = 6.907755278982137&#10;-- Independent excitation/wash PRNG streams avoid block-size-dependent noise.&#10;local seedA,seedB=1357911,2468021&#10;local function noiseA()&#10;  seedA=(seedA*48271)%2147483647&#10;  return seedA*(2.0/2147483647.0)-1.0&#10;end&#10;local function noiseB()&#10;  seedB=(seedB*48271)%2147483647&#10;  return seedB*(2.0/2147483647.0)-1.0&#10;end&#10;for m=1,NMODES do&#10;  R[m]=0.0; Q[m]=0.0; W[m]=0.0&#10;  C[m]=0.0; S[m]=0.0; G[m]=0.0; OG[m]=0.0; SG[m]=0.0&#10;end&#10;&#10;local washEnv, washAttack, energy = 0.0,0.0,0.0&#10;local washLP, washHP = 0.0,0.0&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local bright=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local bell=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local wash=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local choke=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local width=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  local pan=clamp(param(&quot;pan&quot;),-1.0,1.0)&#10;  local left=cos((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  local right=sin((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  if trig then&#10;    hitVelocity=clamp(vel,0.01,1.0)^1.2&#10;    detune=2.0^((rnd()*2.0-1.0)*0.045/12.0)&#10;    local impulse=hitVelocity*(0.97+rnd()*0.06)&#10;    forceFast=forceFast+impulse; forceSlow=forceSlow+impulse&#10;    washEnv=washEnv+impulse; washAttack=washAttack+impulse&#10;    for m=1,NMODES do W[m]=0.94+rnd()*0.12 end&#10;  end&#10;  local pitch=2.0^(tune/12.0)*detune&#10;  local tau=CONTACT*(1.6-bright*0.9)*(1.2-hitVelocity*0.35)&#10;  local fast=exp(-dt/tau); local slow=exp(-dt/(2.0*tau))&#10;  local lp=1.0-exp(-TWO_PI*min(sr*0.4,3500.0+bright*11000.0)*dt)&#10;  local hp=1.0-exp(-TWO_PI*min(sr*0.23,1300.0+bright*1000.0)*dt)&#10;  local effDecay=decay*(1.0-0.985*choke)&#10;  local washFall=exp(-T60_LOG*dt/max(0.003,effDecay*0.65))&#10;  local bloom=exp(-dt/BLOOM)&#10;  local follow=exp(-dt/0.018)&#10;  local dcPole=exp(-TWO_PI*15.0*dt)&#10;  local gain=OUTPUT*(1.0+drive*3.0)&#10;  for m=1,NMODES do&#10;    local f=freq[m]*pitch&#10;    local audible=clamp((sr*0.44-f)/(sr*0.08),0.0,1.0)&#10;    local w=TWO_PI*min(f,sr*0.44)*dt&#10;    local time=max(0.002,effDecay*life[m])&#10;    local d=exp(-T60_LOG*dt/time)&#10;    C[m]=cos(w)*d; S[m]=sin(w)*d&#10;    local tilt=1.0/(1.0+(f/(2000.0+bright*14000.0+hitVelocity*4000.0))^2)&#10;    local zone=(m&lt;=5) and (0.15+bell*1.65) or (1.15-bell*0.75)&#10;    G[m]=amplitude[m]*W[m]*zone*tilt*audible&#10;    OG[m]=audible&#10;    SG[m]=stereo[m]*width*0.35&#10;  end&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    local forceActive=abs(forceSlow)&gt;1e-7 or abs(forceFast)&gt;1e-7&#10;    for i=0,count-1 do&#10;      acc[i]=0.0; side[i]=0.0&#10;      local ff,fs=forceFast,forceSlow&#10;      forceFast=ff*fast; forceSlow=fs*slow&#10;      local noise=noiseA()&#10;      lowNoise=lowNoise+lp*(noise-lowNoise)&#10;      force[i]=(fs-ff)*(dt/tau)*(1.0+lowNoise*0.7)&#10;    end&#10;    for m=1,NMODES do&#10;      local r,q=R[m],Q[m]&#10;      local c,s,g,og,sg=C[m],S[m],G[m],OG[m],SG[m]&#10;      if abs(r)+abs(q)&gt;1e-7 or forceActive then&#10;        for i=0,count-1 do&#10;          q=q+force[i]*g&#10;          local nr=r*c-q*s&#10;          q=r*s+q*c; r=nr&#10;          local x=r*og&#10;          acc[i]=acc[i]+x; side[i]=side[i]+x*sg&#10;        end&#10;      end&#10;      if abs(r)+abs(q)&lt;1e-7 then r=0.0; q=0.0 end&#10;      R[m]=r; Q[m]=q&#10;    end&#10;    for i=0,count-1 do&#10;      local envelope=max(0.0,washEnv-washAttack)&#10;      washEnv=washEnv*washFall; washAttack=washAttack*bloom&#10;      energy=max(abs(acc[i]),energy*follow)&#10;      local noise=noiseB()&#10;      washLP=washLP+lp*(noise-washLP)&#10;      washHP=washHP+hp*(washLP-washHP)&#10;      -- Stochastic unresolved modes; stronger strikes produce a blooming wash.&#10;      -- Energy following is a perceptual approximation of nonlinear behavior.&#10;      local haze=(washLP-washHP)*wash*(envelope*0.20+energy*0.32)&#10;      local mid=acc[i]+haze&#10;      local xL=(mid+side[i])*left; local xR=(mid-side[i])*right&#10;      local yL=xL-dcInL+dcPole*dcL; local yR=xR-dcInR+dcPole*dcR&#10;      dcInL=xL; dcInR=xR; dcL=yL; dcR=yR&#10;      if abs(dcL)&lt;1e-7 then dcL=0.0 end&#10;      if abs(dcR)&lt;1e-7 then dcR=0.0 end&#10;      outL(start+i,tanh(yL*gain)*level)&#10;      outR(start+i,tanh(yR*gain)*level)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(forceFast)&lt;1e-7 then forceFast=0.0 end&#10;  if abs(forceSlow)&lt;1e-7 then forceSlow=0.0 end&#10;  if abs(washEnv)&lt;1e-7 then washEnv=0.0 end&#10;  if abs(washAttack)&lt;1e-7 then washAttack=0.0 end&#10;  if abs(energy)&lt;1e-7 then energy=0.0 end&#10;  if abs(lowNoise)&lt;1e-7 then lowNoise=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="TIP" p3Label="WASH" p4Label="CHOKE" p5Label="WIDTH" />
  <pad name="Open hi-hat" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: TIP&#10;-- @p3: WASH&#10;-- @p4: CHOKE&#10;-- @p5: WIDTH&#10;&#10;-- Open hi-hat. Recommended decay=1.15s; p1=0.6, p2=0.1, p3=0.58, p4=0.12, p5=0.16.&#10;local NMODES=32&#10;local CONTACT=0.0004&#10;local BLOOM=0.001&#10;local OUTPUT=4.98978418485&#10;local freq={680,1001.64,1421.88,1896.52,2456.84,791.1664,1065.57746,1346.97634,1748.6074,2068.08233,2537.50644,2868.33532,3393.85731,3724.74886,4301.22201,4625.50371,5250.14174,5563.24744,6234.38233,6532.91216,7249.48982,7530.76908,8292.10563,8553.94717,9359.59688,9600.16031,10449.8382,10667.5405,11561.0739,11754.5297,12691.8268,12859.8064}&#10;local amplitude={0.34,0.25,0.19,0.14,0.12,0.13,0.122021661,0.114965986,0.108681672,0.10304878,0.0979710145,0.0933701657,0.089182058,0.0853535354,0.0818401937,0.0786046512,0.0756152125,0.0728448276,0.0702702703,0.0678714859,0.065631068,0.0635338346,0.0615664845,0.0597173145,0.0579759863,0.0563333333,0.0547811994,0.0533123028,0.0519201229,0.0505988024,0.0493430657,0.0481481481}&#10;local life={1,0.9,0.85,0.75,0.67,0.48,0.445714286,0.416,0.39,0.367058824,0.346666667,0.328421053,0.312,0.297142857,0.283636364,0.271304348,0.26,0.2496,0.24,0.231111111,0.222857143,0.215172414,0.208,0.201290323,0.195,0.189090909,0.183529412,0.178285714,0.173333333,0.168648649,0.164210526,0.16}&#10;local stereo={0.675463181,-0.996164609,0.793667864,-0.174326781,-0.536572918,0.965657777,-0.887567034,0.343314929,0.381250492,-0.905578362,0.954285094,-0.501789301,-0.21425254,0.817766255,-0.991778853,0.644896733,0.0406932573,-0.704910637,0.998900091,-0.768254661,0.134112228,0.570467634,-0.975430724,0.868085337,-0.304810621,-0.418554465,0.922089485,-0.941331518,0.466174406,0.253823363,-0.840509911,0.98575009}&#10;&#10;-- Standalone FORGE64 Lua 5.4 instrument. No samples / external dependencies.&#10;-- Persistent state and fixed-size scratch arrays are allocated only here.&#10;-- level/pan are applied here; disable their application here if your host applies&#10;-- those controls again after the script (see README).&#10;local CAP = 1024&#10;local acc, side, force = {}, {}, {}&#10;for i = 0, CAP-1 do acc[i]=0.0; side[i]=0.0; force[i]=0.0 end&#10;local R,Q,W,C,S,G,OG,SG = {},{},{},{},{},{},{},{}&#10;local forceFast,forceSlow = 0.0,0.0&#10;local hitVelocity,detune,hitPosition = 0.0,1.0,0.25&#10;local lowNoise,highNoise = 0.0,0.0&#10;local dcInL,dcInR,dcL,dcR = 0.0,0.0,0.0,0.0&#10;local TWO_PI = 6.283185307179586&#10;local T60_LOG = 6.907755278982137&#10;-- Independent excitation/wash PRNG streams avoid block-size-dependent noise.&#10;local seedA,seedB=1357911,2468021&#10;local function noiseA()&#10;  seedA=(seedA*48271)%2147483647&#10;  return seedA*(2.0/2147483647.0)-1.0&#10;end&#10;local function noiseB()&#10;  seedB=(seedB*48271)%2147483647&#10;  return seedB*(2.0/2147483647.0)-1.0&#10;end&#10;for m=1,NMODES do&#10;  R[m]=0.0; Q[m]=0.0; W[m]=0.0&#10;  C[m]=0.0; S[m]=0.0; G[m]=0.0; OG[m]=0.0; SG[m]=0.0&#10;end&#10;&#10;local washEnv, washAttack, energy = 0.0,0.0,0.0&#10;local washLP, washHP = 0.0,0.0&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local bright=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local bell=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local wash=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local choke=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local width=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  local pan=clamp(param(&quot;pan&quot;),-1.0,1.0)&#10;  local left=cos((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  local right=sin((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  if trig then&#10;    hitVelocity=clamp(vel,0.01,1.0)^1.2&#10;    detune=2.0^((rnd()*2.0-1.0)*0.045/12.0)&#10;    local impulse=hitVelocity*(0.97+rnd()*0.06)&#10;    forceFast=forceFast+impulse; forceSlow=forceSlow+impulse&#10;    washEnv=washEnv+impulse; washAttack=washAttack+impulse&#10;    for m=1,NMODES do W[m]=0.94+rnd()*0.12 end&#10;  end&#10;  local pitch=2.0^(tune/12.0)*detune&#10;  local tau=CONTACT*(1.6-bright*0.9)*(1.2-hitVelocity*0.35)&#10;  local fast=exp(-dt/tau); local slow=exp(-dt/(2.0*tau))&#10;  local lp=1.0-exp(-TWO_PI*min(sr*0.4,3500.0+bright*11000.0)*dt)&#10;  local hp=1.0-exp(-TWO_PI*min(sr*0.23,1300.0+bright*1000.0)*dt)&#10;  local effDecay=decay*(1.0-0.985*choke)&#10;  local washFall=exp(-T60_LOG*dt/max(0.003,effDecay*0.65))&#10;  local bloom=exp(-dt/BLOOM)&#10;  local follow=exp(-dt/0.018)&#10;  local dcPole=exp(-TWO_PI*15.0*dt)&#10;  local gain=OUTPUT*(1.0+drive*3.0)&#10;  for m=1,NMODES do&#10;    local f=freq[m]*pitch&#10;    local audible=clamp((sr*0.44-f)/(sr*0.08),0.0,1.0)&#10;    local w=TWO_PI*min(f,sr*0.44)*dt&#10;    local time=max(0.002,effDecay*life[m])&#10;    local d=exp(-T60_LOG*dt/time)&#10;    C[m]=cos(w)*d; S[m]=sin(w)*d&#10;    local tilt=1.0/(1.0+(f/(2000.0+bright*14000.0+hitVelocity*4000.0))^2)&#10;    local zone=(m&lt;=5) and (0.15+bell*1.65) or (1.15-bell*0.75)&#10;    G[m]=amplitude[m]*W[m]*zone*tilt*audible&#10;    OG[m]=audible&#10;    SG[m]=stereo[m]*width*0.35&#10;  end&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    local forceActive=abs(forceSlow)&gt;1e-7 or abs(forceFast)&gt;1e-7&#10;    for i=0,count-1 do&#10;      acc[i]=0.0; side[i]=0.0&#10;      local ff,fs=forceFast,forceSlow&#10;      forceFast=ff*fast; forceSlow=fs*slow&#10;      local noise=noiseA()&#10;      lowNoise=lowNoise+lp*(noise-lowNoise)&#10;      force[i]=(fs-ff)*(dt/tau)*(1.0+lowNoise*0.7)&#10;    end&#10;    for m=1,NMODES do&#10;      local r,q=R[m],Q[m]&#10;      local c,s,g,og,sg=C[m],S[m],G[m],OG[m],SG[m]&#10;      if abs(r)+abs(q)&gt;1e-7 or forceActive then&#10;        for i=0,count-1 do&#10;          q=q+force[i]*g&#10;          local nr=r*c-q*s&#10;          q=r*s+q*c; r=nr&#10;          local x=r*og&#10;          acc[i]=acc[i]+x; side[i]=side[i]+x*sg&#10;        end&#10;      end&#10;      if abs(r)+abs(q)&lt;1e-7 then r=0.0; q=0.0 end&#10;      R[m]=r; Q[m]=q&#10;    end&#10;    for i=0,count-1 do&#10;      local envelope=max(0.0,washEnv-washAttack)&#10;      washEnv=washEnv*washFall; washAttack=washAttack*bloom&#10;      energy=max(abs(acc[i]),energy*follow)&#10;      local noise=noiseB()&#10;      washLP=washLP+lp*(noise-washLP)&#10;      washHP=washHP+hp*(washLP-washHP)&#10;      -- Stochastic unresolved modes; stronger strikes produce a blooming wash.&#10;      -- Energy following is a perceptual approximation of nonlinear behavior.&#10;      local haze=(washLP-washHP)*wash*(envelope*0.20+energy*0.32)&#10;      local mid=acc[i]+haze&#10;      local xL=(mid+side[i])*left; local xR=(mid-side[i])*right&#10;      local yL=xL-dcInL+dcPole*dcL; local yR=xR-dcInR+dcPole*dcR&#10;      dcInL=xL; dcInR=xR; dcL=yL; dcR=yR&#10;      if abs(dcL)&lt;1e-7 then dcL=0.0 end&#10;      if abs(dcR)&lt;1e-7 then dcR=0.0 end&#10;      outL(start+i,tanh(yL*gain)*level)&#10;      outR(start+i,tanh(yR*gain)*level)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(forceFast)&lt;1e-7 then forceFast=0.0 end&#10;  if abs(forceSlow)&lt;1e-7 then forceSlow=0.0 end&#10;  if abs(washEnv)&lt;1e-7 then washEnv=0.0 end&#10;  if abs(washAttack)&lt;1e-7 then washAttack=0.0 end&#10;  if abs(energy)&lt;1e-7 then energy=0.0 end&#10;  if abs(lowNoise)&lt;1e-7 then lowNoise=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="TIP" p3Label="WASH" p4Label="CHOKE" p5Label="WIDTH" />
  <pad name="Crash cymbal" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: BELL&#10;-- @p3: WASH&#10;-- @p4: CHOKE&#10;-- @p5: WIDTH&#10;&#10;-- Crash cymbal. Recommended decay=4.2s; p1=0.6, p2=0.15, p3=0.75, p4=0.14, p5=0.35.&#10;local NMODES=48&#10;local CONTACT=0.0004&#10;local BLOOM=0.035&#10;local OUTPUT=1.7598599577&#10;local freq={270,397.71,564.57,753.03,975.51,315.9,347.385013,377.798864,454.956311,513.787508,585.062789,696.316013,756.409385,878.580391,990.119951,1064.93477,1235.68306,1317.5111,1445.89674,1626.07671,1686.19476,1893.29119,2025.58118,2120.62745,2376.47112,2438.32593,2633.93245,2856.07933,2899.36551,3203.54772,3317.82852,3446.63137,3776.93968,3793.34337,4081.11612,4310.36025,4342.56663,4751.4937,4811.47159,5003.9438,5384.7217,5345.67238,5751.32346,5945.42864,5990.9292,6499.31555,6476.05579,6770.34875}&#10;local amplitude={0.34,0.25,0.19,0.14,0.12,0.13,0.124942792,0.120264317,0.115923567,0.111885246,0.108118812,0.104597701,0.101298701,0.0982014388,0.0952879581,0.0925423729,0.0899505766,0.0875,0.0851794072,0.0829787234,0.0808888889,0.0789017341,0.0770098731,0.0752066116,0.0734858681,0.0718421053,0.0702702703,0.0687657431,0.067324291,0.065942029,0.0646153846,0.0633410673,0.062116041,0.0609375,0.0598028478,0.0587096774,0.057655755,0.0566390041,0.0556574924,0.0547094188,0.0537931034,0.0529069767,0.052049571,0.0512195122,0.0504155125,0.0496363636,0.0488809311,0.0481481481}&#10;local life={1,0.9,0.85,0.75,0.67,0.85,0.811363636,0.776086957,0.74375,0.714,0.686538462,0.661111111,0.6375,0.615517241,0.595,0.575806452,0.5578125,0.540909091,0.525,0.51,0.495833333,0.482432432,0.469736842,0.457692308,0.44625,0.435365854,0.425,0.415116279,0.405681818,0.396666667,0.388043478,0.379787234,0.371875,0.364285714,0.357,0.35,0.343269231,0.336792453,0.330555556,0.324545455,0.31875,0.313157895,0.307758621,0.302542373,0.2975,0.292622951,0.287903226,0.283333333}&#10;local stereo={0.675463181,-0.996164609,0.793667864,-0.174326781,-0.536572918,0.965657777,-0.887567034,0.343314929,0.381250492,-0.905578362,0.954285094,-0.501789301,-0.21425254,0.817766255,-0.991778853,0.644896733,0.0406932573,-0.704910637,0.998900091,-0.768254661,0.134112228,0.570467634,-0.975430724,0.868085337,-0.304810621,-0.418554465,0.922089485,-0.941331518,0.466174406,0.253823363,-0.840509911,0.98575009,-0.613261932,-0.0813191011,0.73319032,-0.999980767,0.741568747,-0.0936755001,-0.603417297,0.983587745,-0.847165547,0.265801356,0.455165049,-0.937073049,0.926818505,-0.429787234,-0.292973695,0.861861156}&#10;&#10;-- Standalone FORGE64 Lua 5.4 instrument. No samples / external dependencies.&#10;-- Persistent state and fixed-size scratch arrays are allocated only here.&#10;-- level/pan are applied here; disable their application here if your host applies&#10;-- those controls again after the script (see README).&#10;local CAP = 1024&#10;local acc, side, force = {}, {}, {}&#10;for i = 0, CAP-1 do acc[i]=0.0; side[i]=0.0; force[i]=0.0 end&#10;local R,Q,W,C,S,G,OG,SG = {},{},{},{},{},{},{},{}&#10;local forceFast,forceSlow = 0.0,0.0&#10;local hitVelocity,detune,hitPosition = 0.0,1.0,0.25&#10;local lowNoise,highNoise = 0.0,0.0&#10;local dcInL,dcInR,dcL,dcR = 0.0,0.0,0.0,0.0&#10;local TWO_PI = 6.283185307179586&#10;local T60_LOG = 6.907755278982137&#10;-- Independent excitation/wash PRNG streams avoid block-size-dependent noise.&#10;local seedA,seedB=1357911,2468021&#10;local function noiseA()&#10;  seedA=(seedA*48271)%2147483647&#10;  return seedA*(2.0/2147483647.0)-1.0&#10;end&#10;local function noiseB()&#10;  seedB=(seedB*48271)%2147483647&#10;  return seedB*(2.0/2147483647.0)-1.0&#10;end&#10;for m=1,NMODES do&#10;  R[m]=0.0; Q[m]=0.0; W[m]=0.0&#10;  C[m]=0.0; S[m]=0.0; G[m]=0.0; OG[m]=0.0; SG[m]=0.0&#10;end&#10;&#10;local washEnv, washAttack, energy = 0.0,0.0,0.0&#10;local washLP, washHP = 0.0,0.0&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local bright=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local bell=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local wash=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local choke=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local width=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  local pan=clamp(param(&quot;pan&quot;),-1.0,1.0)&#10;  local left=cos((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  local right=sin((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  if trig then&#10;    hitVelocity=clamp(vel,0.01,1.0)^1.2&#10;    detune=2.0^((rnd()*2.0-1.0)*0.045/12.0)&#10;    local impulse=hitVelocity*(0.97+rnd()*0.06)&#10;    forceFast=forceFast+impulse; forceSlow=forceSlow+impulse&#10;    washEnv=washEnv+impulse; washAttack=washAttack+impulse&#10;    for m=1,NMODES do W[m]=0.94+rnd()*0.12 end&#10;  end&#10;  local pitch=2.0^(tune/12.0)*detune&#10;  local tau=CONTACT*(1.6-bright*0.9)*(1.2-hitVelocity*0.35)&#10;  local fast=exp(-dt/tau); local slow=exp(-dt/(2.0*tau))&#10;  local lp=1.0-exp(-TWO_PI*min(sr*0.4,3500.0+bright*11000.0)*dt)&#10;  local hp=1.0-exp(-TWO_PI*min(sr*0.23,1300.0+bright*1000.0)*dt)&#10;  local effDecay=decay*(1.0-0.985*choke)&#10;  local washFall=exp(-T60_LOG*dt/max(0.003,effDecay*0.65))&#10;  local bloom=exp(-dt/BLOOM)&#10;  local follow=exp(-dt/0.018)&#10;  local dcPole=exp(-TWO_PI*15.0*dt)&#10;  local gain=OUTPUT*(1.0+drive*3.0)&#10;  for m=1,NMODES do&#10;    local f=freq[m]*pitch&#10;    local audible=clamp((sr*0.44-f)/(sr*0.08),0.0,1.0)&#10;    local w=TWO_PI*min(f,sr*0.44)*dt&#10;    local time=max(0.002,effDecay*life[m])&#10;    local d=exp(-T60_LOG*dt/time)&#10;    C[m]=cos(w)*d; S[m]=sin(w)*d&#10;    local tilt=1.0/(1.0+(f/(2000.0+bright*14000.0+hitVelocity*4000.0))^2)&#10;    local zone=(m&lt;=5) and (0.15+bell*1.65) or (1.15-bell*0.75)&#10;    G[m]=amplitude[m]*W[m]*zone*tilt*audible&#10;    OG[m]=audible&#10;    SG[m]=stereo[m]*width*0.35&#10;  end&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    local forceActive=abs(forceSlow)&gt;1e-7 or abs(forceFast)&gt;1e-7&#10;    for i=0,count-1 do&#10;      acc[i]=0.0; side[i]=0.0&#10;      local ff,fs=forceFast,forceSlow&#10;      forceFast=ff*fast; forceSlow=fs*slow&#10;      local noise=noiseA()&#10;      lowNoise=lowNoise+lp*(noise-lowNoise)&#10;      force[i]=(fs-ff)*(dt/tau)*(1.0+lowNoise*0.7)&#10;    end&#10;    for m=1,NMODES do&#10;      local r,q=R[m],Q[m]&#10;      local c,s,g,og,sg=C[m],S[m],G[m],OG[m],SG[m]&#10;      if abs(r)+abs(q)&gt;1e-7 or forceActive then&#10;        for i=0,count-1 do&#10;          q=q+force[i]*g&#10;          local nr=r*c-q*s&#10;          q=r*s+q*c; r=nr&#10;          local x=r*og&#10;          acc[i]=acc[i]+x; side[i]=side[i]+x*sg&#10;        end&#10;      end&#10;      if abs(r)+abs(q)&lt;1e-7 then r=0.0; q=0.0 end&#10;      R[m]=r; Q[m]=q&#10;    end&#10;    for i=0,count-1 do&#10;      local envelope=max(0.0,washEnv-washAttack)&#10;      washEnv=washEnv*washFall; washAttack=washAttack*bloom&#10;      energy=max(abs(acc[i]),energy*follow)&#10;      local noise=noiseB()&#10;      washLP=washLP+lp*(noise-washLP)&#10;      washHP=washHP+hp*(washLP-washHP)&#10;      -- Stochastic unresolved modes; stronger strikes produce a blooming wash.&#10;      -- Energy following is a perceptual approximation of nonlinear behavior.&#10;      local haze=(washLP-washHP)*wash*(envelope*0.20+energy*0.32)&#10;      local mid=acc[i]+haze&#10;      local xL=(mid+side[i])*left; local xR=(mid-side[i])*right&#10;      local yL=xL-dcInL+dcPole*dcL; local yR=xR-dcInR+dcPole*dcR&#10;      dcInL=xL; dcInR=xR; dcL=yL; dcR=yR&#10;      if abs(dcL)&lt;1e-7 then dcL=0.0 end&#10;      if abs(dcR)&lt;1e-7 then dcR=0.0 end&#10;      outL(start+i,tanh(yL*gain)*level)&#10;      outR(start+i,tanh(yR*gain)*level)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(forceFast)&lt;1e-7 then forceFast=0.0 end&#10;  if abs(forceSlow)&lt;1e-7 then forceSlow=0.0 end&#10;  if abs(washEnv)&lt;1e-7 then washEnv=0.0 end&#10;  if abs(washAttack)&lt;1e-7 then washAttack=0.0 end&#10;  if abs(energy)&lt;1e-7 then energy=0.0 end&#10;  if abs(lowNoise)&lt;1e-7 then lowNoise=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="BELL" p3Label="WASH" p4Label="CHOKE" p5Label="WIDTH" />
