amp(param(&quot;decay&quot;),0.005,8.0)&#10;  local bright=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local bell=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local wash=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local choke=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local width=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  local pan=clamp(param(&quot;pan&quot;),-1.0,1.0)&#10;  local left=cos((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  local right=sin((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  if trig then&#10;    hitVelocity=clamp(vel,0.01,1.0)^1.2&#10;    detune=2.0^((rnd()*2.0-1.0)*0.045/12.0)&#10;    local impulse=hitVelocity*(0.97+rnd()*0.06)&#10;    forceFast=forceFast+impulse; forceSlow=forceSlow+impulse&#10;    washEnv=washEnv+impulse; washAttack=washAttack+impulse&#10;    for m=1,NMODES do W[m]=0.94+rnd()*0.12 end&#10;  end&#10;  local pitch=2.0^(tune/12.0)*detune&#10;  local tau=CONTACT*(1.6-bright*0.9)*(1.2-hitVelocity*0.35)&#10;  local fast=exp(-dt/tau); local slow=exp(-dt/(2.0*tau))&#10;  local lp=1.0-exp(-TWO_PI*min(sr*0.4,3500.0+bright*11000.0)*dt)&#10;  local hp=1.0-exp(-TWO_PI*min(sr*0.23,1300.0+bright*1000.0)*dt)&#10;  local effDecay=decay*(1.0-0.985*choke)&#10;  local washFall=exp(-T60_LOG*dt/max(0.003,effDecay*0.65))&#10;  local bloom=exp(-dt/BLOOM)&#10;  local follow=exp(-dt/0.018)&#10;  local dcPole=exp(-TWO_PI*15.0*dt)&#10;  local gain=OUTPUT*(1.0+drive*3.0)&#10;  for m=1,NMODES do&#10;    local f=freq[m]*pitch&#10;    local audible=clamp((sr*0.44-f)/(sr*0.08),0.0,1.0)&#10;    local w=TWO_PI*min(f,sr*0.44)*dt&#10;    local time=max(0.002,effDecay*life[m])&#10;    local d=exp(-T60_LOG*dt/time)&#10;    C[m]=cos(w)*d; S[m]=sin(w)*d&#10;    local tilt=1.0/(1.0+(f/(2000.0+bright*14000.0+hitVelocity*4000.0))^2)&#10;    local zone=(m&lt;=5) and (0.15+bell*1.65) or (1.15-bell*0.75)&#10;    G[m]=amplitude[m]*W[m]*zone*tilt*audible&#10;    OG[m]=audible&#10;    SG[m]=stereo[m]*width*0.35&#10;  end&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    local forceActive=abs(forceSlow)&gt;1e-7 or abs(forceFast)&gt;1e-7&#10;    for i=0,count-1 do&#10;      acc[i]=0.0; side[i]=0.0&#10;      local ff,fs=forceFast,forceSlow&#10;      forceFast=ff*fast; forceSlow=fs*slow&#10;      local noise=noiseA()&#10;      lowNoise=lowNoise+lp*(noise-lowNoise)&#10;      force[i]=(fs-ff)*(dt/tau)*(1.0+lowNoise*0.7)&#10;    end&#10;    for m=1,NMODES do&#10;      local r,q=R[m],Q[m]&#10;      local c,s,g,og,sg=C[m],S[m],G[m],OG[m],SG[m]&#10;      if abs(r)+abs(q)&gt;1e-7 or forceActive then&#10;        for i=0,count-1 do&#10;          q=q+force[i]*g&#10;          local nr=r*c-q*s&#10;          q=r*s+q*c; r=nr&#10;          local x=r*og&#10;          acc[i]=acc[i]+x; side[i]=side[i]+x*sg&#10;        end&#10;      end&#10;      if abs(r)+abs(q)&lt;1e-7 then r=0.0; q=0.0 end&#10;      R[m]=r; Q[m]=q&#10;    end&#10;    for i=0,count-1 do&#10;      local envelope=max(0.0,washEnv-washAttack)&#10;      washEnv=washEnv*washFall; washAttack=washAttack*bloom&#10;      energy=max(abs(acc[i]),energy*follow)&#10;      local noise=noiseB()&#10;      washLP=washLP+lp*(noise-washLP)&#10;      washHP=washHP+hp*(washLP-washHP)&#10;      -- Stochastic unresolved modes; stronger strikes produce a blooming wash.&#10;      -- Energy following is a perceptual approximation of nonlinear behavior.&#10;      local haze=(washLP-washHP)*wash*(envelope*0.20+energy*0.32)&#10;      local mid=acc[i]+haze&#10;      local xL=(mid+side[i])*left; local xR=(mid-side[i])*right&#10;      local yL=xL-dcInL+dcPole*dcL; local yR=xR-dcInR+dcPole*dcR&#10;      dcInL=xL; dcInR=xR; dcL=yL; dcR=yR&#10;      if abs(dcL)&lt;1e-7 then dcL=0.0 end&#10;      if abs(dcR)&lt;1e-7 then dcR=0.0 end&#10;      outL(start+i,tanh(yL*gain)*level)&#10;      outR(start+i,tanh(yR*gain)*level)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(forceFast)&lt;1e-7 then forceFast=0.0 end&#10;  if abs(forceSlow)&lt;1e-7 then forceSlow=0.0 end&#10;  if abs(washEnv)&lt;1e-7 then washEnv=0.0 end&#10;  if abs(washAttack)&lt;1e-7 then washAttack=0.0 end&#10;  if abs(energy)&lt;1e-7 then energy=0.0 end&#10;  if abs(lowNoise)&lt;1e-7 then lowNoise=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="BELL" p3Label="WASH" p4Label="CHOKE" p5Label="WIDTH" />
  <pad name="Ride bell" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: BELL&#10;-- @p3: WASH&#10;-- @p4: CHOKE&#10;-- @p5: WIDTH&#10;&#10;-- Ride bell. Recommended decay=3.2s; p1=0.6, p2=0.95, p3=0.08, p4=0.15, p5=0.12.&#10;local NMODES=32&#10;local CONTACT=0.0004&#10;local BLOOM=0.035&#10;local OUTPUT=2.93316610163&#10;local freq={540,795.42,1129.14,1506.06,1951.02,631.8,748.704409,899.83227,1184.69504,1438.81702,1735.93249,2162.97716,2437.29663,2915.88215,3366.32426,3693.55449,4357.64565,4711.83403,5233.07649,5945.81037,6220.5392,7038.70686,7581.72665,7985.09216,8996.06652,9274.00535,10060.5606,10950.7956,11155.1802,12364.1388,12841.7365,13375.0226}&#10;local amplitude={0.34,0.25,0.19,0.14,0.12,0.13,0.122021661,0.114965986,0.108681672,0.10304878,0.0979710145,0.0933701657,0.089182058,0.0853535354,0.0818401937,0.0786046512,0.0756152125,0.0728448276,0.0702702703,0.0678714859,0.065631068,0.0635338346,0.0615664845,0.0597173145,0.0579759863,0.0563333333,0.0547811994,0.0533123028,0.0519201229,0.0505988024,0.0493430657,0.0481481481}&#10;local life={1,0.9,0.85,0.75,0.67,0.85,0.789285714,0.736666667,0.690625,0.65,0.613888889,0.581578947,0.5525,0.526190476,0.502272727,0.480434783,0.460416667,0.442,0.425,0.409259259,0.394642857,0.381034483,0.368333333,0.356451613,0.3453125,0.334848485,0.325,0.315714286,0.306944444,0.298648649,0.290789474,0.283333333}&#10;local stereo={0.675463181,-0.996164609,0.793667864,-0.174326781,-0.536572918,0.965657777,-0.887567034,0.343314929,0.381250492,-0.905578362,0.954285094,-0.501789301,-0.21425254,0.817766255,-0.991778853,0.644896733,0.0406932573,-0.704910637,0.998900091,-0.768254661,0.134112228,0.570467634,-0.975430724,0.868085337,-0.304810621,-0.418554465,0.922089485,-0.941331518,0.466174406,0.253823363,-0.840509911,0.98575009}&#10;&#10;-- Standalone FORGE64 Lua 5.4 instrument. No samples / external dependencies.&#10;-- Persistent state and fixed-size scratch arrays are allocated only here.&#10;-- level/pan are applied here; disable their application here if your host applies&#10;-- those controls again after the script (see README).&#10;local CAP = 1024&#10;local acc, side, force = {}, {}, {}&#10;for i = 0, CAP-1 do acc[i]=0.0; side[i]=0.0; force[i]=0.0 end&#10;local R,Q,W,C,S,G,OG,SG = {},{},{},{},{},{},{},{}&#10;local forceFast,forceSlow = 0.0,0.0&#10;local hitVelocity,detune,hitPosition = 0.0,1.0,0.25&#10;local lowNoise,highNoise = 0.0,0.0&#10;local dcInL,dcInR,dcL,dcR = 0.0,0.0,0.0,0.0&#10;local TWO_PI = 6.283185307179586&#10;local T60_LOG = 6.907755278982137&#10;-- Independent excitation/wash PRNG streams avoid block-size-dependent noise.&#10;local seedA,seedB=1357911,2468021&#10;local function noiseA()&#10;  seedA=(seedA*48271)%2147483647&#10;  return seedA*(2.0/2147483647.0)-1.0&#10;end&#10;local function noiseB()&#10;  seedB=(seedB*48271)%2147483647&#10;  return seedB*(2.0/2147483647.0)-1.0&#10;end&#10;for m=1,NMODES do&#10;  R[m]=0.0; Q[m]=0.0; W[m]=0.0&#10;  C[m]=0.0; S[m]=0.0; G[m]=0.0; OG[m]=0.0; SG[m]=0.0&#10;end&#10;&#10;local washEnv, washAttack, energy = 0.0,0.0,0.0&#10;local washLP, washHP = 0.0,0.0&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local bright=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local bell=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local wash=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local choke=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local width=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  local pan=clamp(param(&quot;pan&quot;),-1.0,1.0)&#10;  local left=cos((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  local right=sin((pan+1.0)*0.7853981633974483)*1.4142135623730951&#10;  if trig then&#10;    hitVelocity=clamp(vel,0.01,1.0)^1.2&#10;    detune=2.0^((rnd()*2.0-1.0)*0.045/12.0)&#10;    local impulse=hitVelocity*(0.97+rnd()*0.06)&#10;    forceFast=forceFast+impulse; forceSlow=forceSlow+impulse&#10;    washEnv=washEnv+impulse; washAttack=washAttack+impulse&#10;    for m=1,NMODES do W[m]=0.94+rnd()*0.12 end&#10;  end&#10;  local pitch=2.0^(tune/12.0)*detune&#10;  local tau=CONTACT*(1.6-bright*0.9)*(1.2-hitVelocity*0.35)&#10;  local fast=exp(-dt/tau); local slow=exp(-dt/(2.0*tau))&#10;  local lp=1.0-exp(-TWO_PI*min(sr*0.4,3500.0+bright*11000.0)*dt)&#10;  local hp=1.0-exp(-TWO_PI*min(sr*0.23,1300.0+bright*1000.0)*dt)&#10;  local effDecay=decay*(1.0-0.985*choke)&#10;  local washFall=exp(-T60_LOG*dt/max(0.003,effDecay*0.65))&#10;  local bloom=exp(-dt/BLOOM)&#10;  local follow=exp(-dt/0.018)&#10;  local dcPole=exp(-TWO_PI*15.0*dt)&#10;  local gain=OUTPUT*(1.0+drive*3.0)&#10;  for m=1,NMODES do&#10;    local f=freq[m]*pitch&#10;    local audible=clamp((sr*0.44-f)/(sr*0.08),0.0,1.0)&#10;    local w=TWO_PI*min(f,sr*0.44)*dt&#10;    local time=max(0.002,effDecay*life[m])&#10;    local d=exp(-T60_LOG*dt/time)&#10;    C[m]=cos(w)*d; S[m]=sin(w)*d&#10;    local tilt=1.0/(1.0+(f/(2000.0+bright*14000.0+hitVelocity*4000.0))^2)&#10;    local zone=(m&lt;=5) and (0.15+bell*1.65) or (1.15-bell*0.75)&#10;    G[m]=amplitude[m]*W[m]*zone*tilt*audible&#10;    OG[m]=audible&#10;    SG[m]=stereo[m]*width*0.35&#10;  end&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    local forceActive=abs(forceSlow)&gt;1e-7 or abs(forceFast)&gt;1e-7&#10;    for i=0,count-1 do&#10;      acc[i]=0.0; side[i]=0.0&#10;      local ff,fs=forceFast,forceSlow&#10;      forceFast=ff*fast; forceSlow=fs*slow&#10;      local noise=noiseA()&#10;      lowNoise=lowNoise+lp*(noise-lowNoise)&#10;      force[i]=(fs-ff)*(dt/tau)*(1.0+lowNoise*0.7)&#10;    end&#10;    for m=1,NMODES do&#10;      local r,q=R[m],Q[m]&#10;      local c,s,g,og,sg=C[m],S[m],G[m],OG[m],SG[m]&#10;      if abs(r)+abs(q)&gt;1e-7 or forceActive then&#10;        for i=0,count-1 do&#10;          q=q+force[i]*g&#10;          local nr=r*c-q*s&#10;          q=r*s+q*c; r=nr&#10;          local x=r*og&#10;          acc[i]=acc[i]+x; side[i]=side[i]+x*sg&#10;        end&#10;      end&#10;      if abs(r)+abs(q)&lt;1e-7 then r=0.0; q=0.0 end&#10;      R[m]=r; Q[m]=q&#10;    end&#10;    for i=0,count-1 do&#10;      local envelope=max(0.0,washEnv-washAttack)&#10;      washEnv=washEnv*washFall; washAttack=washAttack*bloom&#10;      energy=max(abs(acc[i]),energy*follow)&#10;      local noise=noiseB()&#10;      washLP=washLP+lp*(noise-washLP)&#10;      washHP=washHP+hp*(washLP-washHP)&#10;      -- Stochastic unresolved modes; stronger strikes produce a blooming wash.&#10;      -- Energy following is a perceptual approximation of nonlinear behavior.&#10;      local haze=(washLP-washHP)*wash*(envelope*0.20+energy*0.32)&#10;      local mid=acc[i]+haze&#10;      local xL=(mid+side[i])*left; local xR=(mid-side[i])*right&#10;      local yL=xL-dcInL+dcPole*dcL; local yR=xR-dcInR+dcPole*dcR&#10;      dcInL=xL; dcInR=xR; dcL=yL; dcR=yR&#10;      if abs(dcL)&lt;1e-7 then dcL=0.0 end&#10;      if abs(dcR)&lt;1e-7 then dcR=0.0 end&#10;      outL(start+i,tanh(yL*gain)*level)&#10;      outR(start+i,tanh(yR*gain)*level)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(forceFast)&lt;1e-7 then forceFast=0.0 end&#10;  if abs(forceSlow)&lt;1e-7 then forceSlow=0.0 end&#10;  if abs(washEnv)&lt;1e-7 then washEnv=0.0 end&#10;  if abs(washAttack)&lt;1e-7 then washAttack=0.0 end&#10;  if abs(energy)&lt;1e-7 then energy=0.0 end&#10;  if abs(lowNoise)&lt;1e-7 then lowNoise=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="BELL" p3Label="WASH" p4Label="CHOKE" p5Label="WIDTH" />
  <pad name="Splash cymbal" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: BELL&#10;-- @p3: WASH&#10;-- @p4: CHOKE&#10;-- @p5: WIDTH&#10;&#10;-- Splash cymbal. Recommended decay=1.4s; p1=0.6, p2=0.08, p3=0.65, p4=0.22, p5=0.3.&#10;local NMODES=48&#10;local CONTACT=0.0004&#10;local BLOOM=0.035&#10;local OUTPUT=3.32009128633&#10;local freq={490,721.77,1024.59,1366.61,1770.37,573.3,630.439468,685.634975,825.661454,932.429182,1061.78062,1263.68462,1372.74296,1594.46071,1796.88436,1932.65939,2242.53592,2391.03866,2624.03483,2951.0281,3060.13124,3435.9729,3676.05473,3848.54612,4312.85499,4425.11003,4780.09963,5183.25507,5261.81148,5813.84586,6021.24435,6254.99768,6854.44609,6884.21575,7406.46999,7822.50564,7880.95425,8623.08116,8731.92992,9081.23135,9772.27271,9701.40544,10437.587,10789.852,10872.4271,11795.0541,11752.842,12286.9292}&#10;local amplitude={0.34,0.25,0.19,0.14,0.12,0.13,0.124942792,0.120264317,0.115923567,0.111885246,0.108118812,0.104597701,0.101298701,0.0982014388,0.0952879581,0.0925423729,0.0899505766,0.0875,0.0851794072,0.0829787234,0.0808888889,0.0789017341,0.0770098731,0.0752066116,0.0734858681,0.0718421053,0.0702702703,0.0687657431,0.067324291,0.065942029,0.0646153846,0.0633410673,0.062116041,0.0609375,0.0598028478,0.0587096774,0.057655755,0.0566390041,0.0556574924,0.0547094188,0.0537931034,0.0529069767,0.052049571,0.0512195122,0.0504155125,0.0496363636,0.0488809311,0.0481481481}&#10;local life={1,0.9,0.85,0.75,0.67,0.85,0.811363636,0.776086957,0.74375,0.714,0.686538462,0.661111111,0.6375,0.615517241,0.595,0.575806452,0.5578125,0.540909091,0.525,0.51,0.495833333,0.482432432,0.469736842,0.457692308,0.44625,0.435365854,0.425,0.415116279,0.405681818,0.396666667,0.388043478,0.379787234,0.371875,0.364285714,0.357,0.35,0.343269231,0.336792453,0.330555556,0.324545455,0.31875,0.313157895,0.307758621,0.302542373,0.2975,0.292622951,0.287903226,0.283333333}&#10;local stereo={0.675463181,-0.996164609,0.793667864,