<?xml version='1.0' encoding='utf-8'?>
<FORGE64BANK version="1" index="3">
  <pad name="CR78 Bass Drum" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: PUNCH&#10;-- @p2: CLICK&#10;-- @p3: BODY&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Bass Drum. Original synthesis interpretation.&#10;local KIND=&quot;kickcr&quot;&#10;local BASE=66&#10;local OUTPUT=1.2632379108&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="PUNCH" p2Label="CLICK" p3Label="BODY" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Snare Drum" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: SNAPPY&#10;-- @p2: NOISE TONE&#10;-- @p3: BODY&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Snare Drum. Original synthesis interpretation.&#10;local KIND=&quot;snare808&quot;&#10;local BASE=175&#10;local OUTPUT=1.04334372549&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="SNAPPY" p2Label="NOISE TONE" p3Label="BODY" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Rim Shot" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: HARDNESS&#10;-- @p2: CLICK&#10;-- @p3: TONE&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Rim Shot. Original synthesis interpretation.&#10;local KIND=&quot;rim&quot;&#10;local BASE=610&#10;local OUTPUT=1.14622241419&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="HARDNESS" p2Label="CLICK" p3Label="TONE" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Hi Hat" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: METAL&#10;-- @p3: TONE&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Hi Hat. Original synthesis interpretation.&#10;local KIND=&quot;hat808&quot;&#10;local BASE=0&#10;local OUTPUT=5.1196925244&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="METAL" p3Label="TONE" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Cymbal" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: JINGLES&#10;-- @p3: NOISE&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Cymbal. Original synthesis interpretation.&#10;local KIND=&quot;tamb&quot;&#10;local BASE=0&#10;local OUTPUT=3.12150553714&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="JINGLES" p3Label="NOISE" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Low Bongo" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: PUNCH&#10;-- @p2: SKIN&#10;-- @p3: BODY&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Low Bongo. Original synthesis interpretation.&#10;local KIND=&quot;bongo&quot;&#10;local BASE=420&#10;local OUTPUT=0.97860550853&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="PUNCH" p2Label="SKIN" p3Label="BODY" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Low Conga" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: PUNCH&#10;-- @p2: SKIN&#10;-- @p3: BODY&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Low Conga. Original synthesis interpretation.&#10;local KIND=&quot;bongo&quot;&#10;local BASE=205&#10;local OUTPUT=1.01379573071&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="PUNCH" p2Label="SKIN" p3Label="BODY" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 High Conga" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: PUNCH&#10;-- @p2: SKIN&#10;-- @p3: BODY&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: High Conga. Original synthesis interpretation.&#10;local KIND=&quot;bongo&quot;&#10;local BASE=320&#10;local OUTPUT=0.984925118964&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="PUNCH" p2Label="SKIN" p3Label="BODY" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Claves" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: HARDNESS&#10;-- @p2: CLICK&#10;-- @p3: WOOD&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Claves. Original synthesis interpretation.&#10;local KIND=&quot;clave&quot;&#10;local BASE=2300&#10;local OUTPUT=0.781037463076&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="HARDNESS" p2Label="CLICK" p3Label="WOOD" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Cowbell" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: BALANCE&#10;-- @p3: BELL&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Cowbell. Original synthesis interpretation.&#10;local KIND=&quot;cowbell&quot;&#10;local BASE=600&#10;local OUTPUT=0.53686223598&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="BALANCE" p3Label="BELL" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Metallic Beat" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: BALANCE&#10;-- @p3: METAL&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Metallic Beat. Original synthesis interpretation.&#10;local KIND=&quot;metalbeat&quot;&#10;local BASE=920&#10;local OUTPUT=1.36058784779&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="BALANCE" p3Label="METAL" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Tambourine" moduleId="hat_closed" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: JINGLES&#10;-- @p3: NOISE&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Tambourine. Original synthesis interpretation.&#10;local KIND=&quot;tamb&quot;&#10;local BASE=0&#10;local OUTPUT=4.52961363249&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="JINGLES" p3Label="NOISE" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Maracas" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: BRIGHT&#10;-- @p2: COLOR&#10;-- @p3: TEXTURE&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Maracas. Original synthesis interpretation.&#10;local KIND=&quot;noise&quot;&#10;local BASE=0&#10;local OUTPUT=1.01196349664&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="BRIGHT" p2Label="COLOR" p3Label="TEXTURE" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Guiro" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: GRAIN&#10;-- @p2: SPEED&#10;-- @p3: WOOD&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Guiro. Original synthesis interpretation.&#10;local KIND=&quot;guiro&quot;&#10;local BASE=2100&#10;local OUTPUT=1.7338934609&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="GRAIN" p2Label="SPEED" p3Label="WOOD" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Bass Drum Soft [Var]" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: PUNCH&#10;-- @p2: CLICK&#10;-- @p3: BODY&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Bass Drum Soft [Var]. Original synthesis interpretation.&#10;local KIND=&quot;kickcr&quot;&#10;local BASE=54&#10;local OUTPUT=1.16446289176&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="PUNCH" p2Label="CLICK" p3Label="BODY" p4Label="DAMPING" p5Label="ANALOG" />
  <pad name="CR78 Snare Brush [Var]" moduleId="user_acoustic_kick" sample="" colour="-12947803" scriptOn="1" script="-- @p1: SNAPPY&#10;-- @p2: NOISE TONE&#10;-- @p3: BODY&#10;-- @p4: DAMPING&#10;-- @p5: ANALOG&#10;&#10;-- Roland CR-78: Snare Brush [Var]. Original synthesis interpretation.&#10;local KIND=&quot;snare808&quot;&#10;local BASE=155&#10;local OUTPUT=1.04625127746&#10;local VCO_RATIO=1.61&#10;local SWEEP_DEPTH=0.62&#10;local BEND_TIME=0.015&#10;local NOISE_HPF=650&#10;local LP_SCALE=0.8&#10;local METAL_SCALE=0.91&#10;local NOISE_SCALE=0.9&#10;local BODY_SHAPE=0.15&#10;local MODE_SCALE=1.0&#10;&#10;-- Original sample-free vintage voicing for the FORGE64 instrument API.&#10;-- All tables, helpers and persistent state are allocated at module scope.&#10;local CAP=1024&#10;local acc={}&#10;for i=0,CAP-1 do acc[i]=0.0 end&#10;local phase={0,0,0,0,0,0}&#10;local frequencies={205.3,304.4,369.6,522.7,540.0,800.0}&#10;local digitalModes={3400,4870,6210,7430,9150,11300}&#10;local env,pitchEnv,clickEnv=0.0,0.0,0.0&#10;local hit=0.0&#10;local drift=1.0&#10;local clock=1000.0&#10;local noiseLP,noiseHP,metalHP,metalLP=0.0,0.0,0.0,0.0&#10;local bandX1,bandX2,bandY1,bandY2=0.0,0.0,0.0,0.0&#10;local dcIn,dcOut=0.0,0.0&#10;local held,holdPhase=0.0,0.0&#10;local clapTail,tailStarted=0.0,true&#10;local seed=1245791&#10;local TAU=6.283185307179586&#10;local function noise()&#10;  seed=(seed*48271)%2147483647&#10;  return seed*(2.0/2147483647.0)-1.0&#10;end&#10;local function blep(t,d)&#10;  if t&lt;d then local x=t/d; return x+x-x*x-1.0 end&#10;  if t&gt;1.0-d then local x=(t-1.0)/d; return x*x+x+x+1.0 end&#10;  return 0.0&#10;end&#10;local function square(t,d)&#10;  local v=(t&lt;0.5) and 1.0 or -1.0&#10;  return v+blep(t,d)-blep((t+0.5)%1.0,d)&#10;end&#10;&#10;function process()&#10;  local dt=1.0/sr&#10;  local tune=clamp(param(&quot;tune&quot;),-24.0,24.0)&#10;  local decay=clamp(param(&quot;decay&quot;),0.005,8.0)&#10;  local p1=clamp(param(&quot;p1&quot;),0.0,1.0)&#10;  local p2=clamp(param(&quot;p2&quot;),0.0,1.0)&#10;  local p3=clamp(param(&quot;p3&quot;),0.0,1.0)&#10;  local p4=clamp(param(&quot;p4&quot;),0.0,1.0)&#10;  local p5=clamp(param(&quot;p5&quot;),0.0,1.0)&#10;  local drive=clamp(param(&quot;drive&quot;),0.0,1.0)&#10;  local level=clamp(param(&quot;level&quot;),0.0,1.0)&#10;  -- The host handles pad panning downstream: emit centred mono here.&#10;  if trig then&#10;    hit=clamp(vel,0.01,1.0)^1.15&#10;    drift=2.0^((rnd()*2.0-1.0)*p5*0.12/12.0)&#10;    if env&lt;1e-6 then for k=1,6 do phase[k]=0.0 end end&#10;    env=env+hit*(1.0+(rnd()*2.0-1.0)*p5*0.025)&#10;    pitchEnv=max(pitchEnv,hit)&#10;    clickEnv=clickEnv+hit&#10;    clock=0.0; tailStarted=false&#10;  end&#10;  local pitch=2.0^(tune/12.0)*drift&#10;  local life=decay*(1.0-p4*0.87)&#10;  local fall=exp(-6.907755278982137*dt/max(0.002,life))&#10;  local pitchFall=exp(-dt/BEND_TIME)&#10;  local clickFall=exp(-dt/0.0014)&#10;  local tailFall=exp(-6.907755278982137*dt/max(.004,life*.75))&#10;  local cutoff=(1800.0+p2*11500.0)*LP_SCALE&#10;  if KIND==&quot;clap&quot; then cutoff=3000.0+p1*6500.0 end&#10;  if KIND==&quot;hat808&quot; or KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot; or KIND==&quot;tamb&quot; then cutoff=4500.0+p1*11000.0 end&#10;  local lp=1.0-exp(-TAU*min(sr*.4,cutoff)*dt)&#10;  local lowcut=NOISE_HPF&#10;  if KIND==&quot;hat808&quot; or (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then lowcut=3000.0+p3*3500.0 end&#10;  if KIND==&quot;tamb&quot; then lowcut=2200.0 end&#10;  local hp=1.0-exp(-TAU*min(sr*.3,lowcut)*dt)&#10;  local mhp=1.0-exp(-TAU*min(sr*.3,3500.0+p3*3000.0)*dt)&#10;  local mlp=1.0-exp(-TAU*min(sr*.4,6500.0+p1*9000.0)*dt)&#10;  -- Stable RBJ bandpass for bell/rim/wood coloration, coefficients per block.&#10;  local centre=1800.0+p3*1100.0&#10;  if KIND==&quot;cowbell&quot; then centre=BASE*(1.1+p3*.9) end&#10;  if KIND==&quot;guiro&quot; then centre=BASE*pitch end&#10;  local w=TAU*min(sr*.4,centre)*dt&#10;  local alpha=sin(w)/(2.0*(.8+p3*2.0))&#10;  local inv=1.0/(1.0+alpha)&#10;  local b0=alpha*inv; local b2=-b0&#10;  local a1=-2.0*cos(w)*inv; local a2=(1.0-alpha)*inv&#10;  local dc=exp(-TAU*12.0*dt)&#10;  local output=OUTPUT*(1.0+drive*3.0)&#10;  local start=0&#10;  while start&lt;n do&#10;    local count=min(CAP,n-start)&#10;    for i=0,count-1 do&#10;      local nz=noise()&#10;      noiseLP=noiseLP+lp*(nz-noiseLP)&#10;      noiseHP=noiseHP+hp*((noiseLP-noiseHP)*NOISE_SCALE)&#10;      local filtered=(noiseLP-noiseHP)*NOISE_SCALE&#10;      local attack=min(1.0,clock/(.00065-p1*.0005))&#10;      local amplitude=env*attack&#10;      local x=0.0&#10;      if KIND==&quot;kick808&quot; or KIND==&quot;kick909&quot; or KIND==&quot;kickcr&quot; then&#10;        local depth=(KIND==&quot;kick909&quot;) and (0.65+p1*3.1) or (p1*SWEEP_DEPTH)&#10;        local f=min(sr*.4,BASE*pitch*(1.0+depth*pitchEnv))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local body=sin(TAU*phase[1])&#10;        if KIND==&quot;kick909&quot; then body=tanh(body*(1.0+p3*1.8))*.78 end&#10;        x=body*amplitude*(.65+p3*.6)+filtered*clickEnv*p2*.18*attack&#10;      elseif KIND==&quot;snare808&quot; or KIND==&quot;snare909&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*VCO_RATIO*pitch*dt)%1.0&#10;        local body=sin(TAU*phase[1])*.65+sin(TAU*phase[2])*.35&#10;        body=tanh(body*(1.0+BODY_SHAPE))/(1.0+BODY_SHAPE*.5)&#10;        if KIND==&quot;snare909&quot; then&#10;          body=tanh(body*1.8)*.7&#10;          filtered=filtered*(.7+.3*sin(TAU*phase[2])^2)&#10;        end&#10;        x=body*amplitude*(.17+p3*.35)+filtered*amplitude*(.55+p1*1.3)&#10;      elseif KIND==&quot;tom808&quot; or KIND==&quot;bongo&quot; then&#10;        local f=min(sr*.4,BASE*pitch*(1.0+pitchEnv*p1*.5))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        phase[2]=(phase[2]+f*VCO_RATIO*dt)%1.0&#10;        local body=sin(TAU*phase[1])+.12*sin(TAU*phase[2])&#10;        x=body*amplitude*(.6+p3*.45)+filtered*amplitude*p2*.18&#10;&#10;      elseif KIND==&quot;sds&quot; then&#10;        local f=min(sr*.35,BASE*pitch*(1.0+pitchEnv*(.1+p1*SWEEP_DEPTH)))&#10;        phase[1]=(phase[1]+f*dt)%1.0&#10;        local tone=tanh(sin(TAU*phase[1])*(1.0+BODY_SHAPE))&#10;        x=(tone*(1.0-p2*.88)+filtered*p2*1.5)*amplitude&#10;        x=x+filtered*clickEnv*p3*.4*attack&#10;      elseif KIND==&quot;clave&quot; then&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        phase[2]=(phase[2]+min(sr*.35,BASE*1.61*pitch)*dt)%1.0&#10;        x=(sin(TAU*phase[1])+(.05+p3*.4)*sin(TAU*phase[2]))*amplitude&#10;        x=x+filtered*clickEnv*p2*.15*attack&#10;      elseif KIND==&quot;noise&quot; then&#10;        x=filtered*amplitude*(.55+p1*.8)*(1.0+p3*.5*sin(TAU*clock*(90.0+p2*400.0)*pitch))&#10;      elseif KIND==&quot;metalbeat&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.37*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0;phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(.7-p2*.4)+square(phase[2],d2)*(.2+p2*.5))*amplitude&#10;      elseif KIND==&quot;quijada&quot; then&#10;        local cycle=(clock*(32.0+p2*75.0))%1.0&#10;        local chatter=exp(-cycle*(4.0+p1*10.0))&#10;        phase[1]=(phase[1]+min(sr*.35,BASE*pitch)*dt)%1.0&#10;        x=(filtered*.6+sin(TAU*phase[1])*.3)*amplitude*chatter&#10;      elseif KIND==&quot;clap&quot; then&#10;        local spacing=.007+p2*.006&#10;        local last=spacing*3.0&#10;        local burst=0.0&#10;        if clock&lt;last+.006 then&#10;          local localTime=clock%spacing&#10;          local envelope=exp(-localTime/.0022)*min(1.0,localTime/.00018)&#10;          burst=hit*envelope&#10;        end&#10;        if clock&gt;=last and not tailStarted then&#10;          clapTail=clapTail+hit; tailStarted=true&#10;        end&#10;        local tailAttack=clamp((clock-last)/.0005,0.0,1.0)&#10;        x=filtered*(burst*.85+clapTail*(.25+p3*.7)*tailAttack)&#10;      elseif KIND==&quot;cowbell&quot; then&#10;        local d1=min(.4,BASE*pitch*dt); local d2=min(.4,BASE*1.48148148148*pitch*dt)&#10;        phase[1]=(phase[1]+d1)%1.0; phase[2]=(phase[2]+d2)%1.0&#10;        x=(square(phase[1],d1)*(1.0-p2*.65)+square(phase[2],d2)*(.3+p2*.7))*amplitude&#10;      elseif KIND==&quot;rim&quot; then&#10;        phase[1]=(phase[1]+BASE*pitch*dt)%1.0&#10;        phase[2]=(phase[2]+BASE*1.50926*pitch*dt)%1.0&#10;        phase[3]=(phase[3]+BASE*3.14815*pitch*dt)%1.0&#10;        x=(sin(TAU*phase[1])*.35+sin(TAU*phase[2])*.4+sin(TAU*phase[3])*(.2+p3*.3))*amplitude&#10;        x=x+filtered*clickEnv*p2*.2*attack&#10;      elseif KIND==&quot;guiro&quot; then&#10;        local cycle=(clock*(45.0+p2*110.0))%1.0&#10;        local scratch=exp(-cycle*(8.0+p1*16.0))&#10;        x=filtered*amplitude*(.3+scratch*2.3)&#10;      else&#10;        local metal=0.0&#10;        for k=1,6 do&#10;          local f=((KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) and digitalModes[k]*MODE_SCALE or frequencies[k])*METAL_SCALE&#10;          local d=min(.4,f*pitch*dt)&#10;          phase[k]=(phase[k]+d)%1.0&#10;          if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;            metal=metal+sin(TAU*phase[k])*.1666666667&#10;          else metal=metal+square(phase[k],d)*.1666666667 end&#10;        end&#10;        if (KIND==&quot;hat909&quot; or KIND==&quot;cym909&quot;) then&#10;          -- Procedural grain and six-bit quantization approximate vintage PCM&#10;          -- texture. No original 909 ROM or recorded cymbal samples are used.&#10;          holdPhase=holdPhase+min(1.0,12000.0*pitch/sr)&#10;          if holdPhase&gt;=1.0 then&#10;            holdPhase=holdPhase-1.0&#10;            held=floor(clamp(filtered*.85+metal*(.2+p2*.5),-1.0,1.0)*31.0+.5)/31.0&#10;          end&#10;          x=(held*p3+(filtered*.85+metal*(.2+p2*.5))*(1.0-p3))*amplitude&#10;        else&#10;          metalHP=metalHP+mhp*(metal-metalHP)&#10;          local high=metal-metalHP&#10;          metalLP=metalLP+mlp*(high-metalLP)&#10;          local mix=(KIND==&quot;tamb&quot;) and p2 or p2*.85+.15&#10;          x=(metalLP*mix+filtered*(1.0-mix)*.5)*amplitude&#10;        end&#10;      end&#10;      if KIND==&quot;cowbell&quot; or KIND==&quot;guiro&quot; or KIND==&quot;quijada&quot; or KIND==&quot;metalbeat&quot; then&#10;        local band=b0*x+b2*bandX2-a1*bandY1-a2*bandY2&#10;        bandX2=bandX1; bandX1=x; bandY2=bandY1; bandY1=band&#10;        x=band*(1.0+p1*.7)&#10;      end&#10;      acc[i]=x&#10;      env=env*fall; pitchEnv=pitchEnv*pitchFall; clickEnv=clickEnv*clickFall&#10;      clapTail=clapTail*tailFall; clock=clock+dt&#10;    end&#10;    for i=0,count-1 do&#10;      local x=acc[i]&#10;      local y=x-dcIn+dc*dcOut&#10;      dcIn=x; dcOut=y&#10;      if abs(dcOut)&lt;1e-7 then dcOut=0.0 end&#10;      local value=tanh(y*output)*level&#10;      outL(start+i,value); outR(start+i,value)&#10;    end&#10;    start=start+count&#10;  end&#10;  if abs(env)&lt;1e-7 then env=0.0 end&#10;  if abs(pitchEnv)&lt;1e-7 then pitchEnv=0.0 end&#10;  if abs(clickEnv)&lt;1e-7 then clickEnv=0.0 end&#10;  if abs(clapTail)&lt;1e-7 then clapTail=0.0 end&#10;  if abs(bandY1)&lt;1e-7 then bandY1=0.0 end&#10;  if abs(bandY2)&lt;1e-7 then bandY2=0.0 end&#10;end&#10;" gainTrim="1.0" sampleStart="0.0" sampleEnd="1.0" loopStart="0.0" loopEnd="1.0" loopOn="0" reverseOn="0" mute="0" solo="0" p1Label="SNAPPY" p2Label="NOISE TONE" p3Label="BODY" p4Label="DAMPING" p5Label="ANALOG" />
